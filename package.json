{
  "name": "emma-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notification service foundation for Emma Notify",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && npm run prisma:generate && tsc -p tsconfig.json",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "dev:api": "node --watch --loader ts-node/esm src/api/index.ts",
    "dev:worker": "node --watch --loader ts-node/esm src/worker/index.ts",
    "test": "vitest run",
    "db:summary": "node dist/db/summary.js",
    "db:inspect-case": "node dist/db/inspect-case.js",
    "db:latest-digest": "node dist/db/latest-digest.js",
    "db:retry-detail-url-failures": "node dist/db/retry-detail-url-failures.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
