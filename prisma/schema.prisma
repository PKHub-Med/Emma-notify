generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum CaseType {
  SERVICE_ORDER
  INSPECTION
}

enum EventType {
  CASE_CREATED
  SERVICE_STATUS_CHANGED
  INSPECTION_STATUS_CHANGED
  RECIPIENT_CHANGED
}

enum BufferStatus {
  OPEN
  READY
  CLOSED
  CANCELLED
}

enum DigestType {
  CASE_DIGEST
  INSPECTION_REMINDER
  VISIT
}

enum DigestStatus {
  CREATED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum SyncEntityType {
  SERVICE_ORDER
  INSPECTION
  CONTACT
  TASK
  HOSPITAL
  SERVICE_ORDER_REPORTED_AT
}

enum SyncStatus {
  IDLE
  RUNNING
  ERROR
}

enum CommunicationSourceEntityType {
  SERVICE_ORDER
  TASK
}

enum CommunicationScenario {
  REPAIR_RECEIVED
  REPAIR_COMPLETED
  INSPECTION_DATE_PROPOSED
  INSPECTION_DATE_CONFIRMED
  INSPECTION_REMINDER
  INSPECTION_COMPLETED
}

enum CommunicationRecipientType {
  CLIENT
  TIEMED_FALLBACK
}

enum CommunicationRecipientResolutionStatus {
  READY
  INVALID
  FALLBACK
  FAILED
}

enum CommunicationDeliveryStatus {
  SCHEDULED
  READY
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum CommunicationDeliveryScheduleReason {
  EVENT_DRIVEN
  REMINDER_0600
}

enum CommunicationDeliveryCancelReason {
  REMINDER_EXPIRED
  SOURCE_STATE_CHANGED
  INVALID_REMINDER_DATE
  PRE_ACTIVATION
  RECIPIENT_OPTED_OUT
}

model TrackedCase {
  id                  String          @id @default(cuid())
  caseType            CaseType
  airtableRecordId    String
  businessNumber      String?
  clientOrderNumber   String?
  caseSubtype         String?
  serviceOrderType    String?
  emmaCustomerStatus  String?
  emmaMailTemplate    String?
  caseLocation        String?
  hospitalName        String?
  sourceHospitalRecordId String?
  deviceAirtableId    String?
  deviceName          String?
  manufacturer        String?
  model               String?
  serialNumber        String?
  inventoryNumber     String?
  currentStatus       String?
  faultDescription    String?
  sourceSnapshot      Json?
  sourceCreatedAt     DateTime?
  reportedAt          DateTime?
  sourceModifiedAt    DateTime?
  inspectionDueDate       DateTime?
  inspectionDueDateRaw    String?
  inspectionScheduledDate DateTime?
  inspectionBookingStatus String?
  firstSeenAt         DateTime        @default(now())
  lastSeenAt          DateTime        @default(now())
  active              Boolean         @default(true)
  recipients          CaseRecipient[]
  events              CaseEvent[]
  bufferItems         BufferItem[]
  digestItems         DigestItem[]

  @@unique([caseType, airtableRecordId])
  @@index([active, lastSeenAt])
  @@index([sourceModifiedAt])
  @@index([sourceHospitalRecordId, caseType, active, sourceModifiedAt, airtableRecordId])
  @@index([sourceHospitalRecordId, caseType, active, reportedAt, airtableRecordId])
}

model TrackedTask {
  id                          String   @id @default(cuid())
  airtableRecordId            String   @unique
  taskNumber                  String?
  day                         String?
  activity                    String?
  completed                   Boolean?
  status                      String?
  emmaCustomerStatus          String?
  emmaMailTemplate            String?
  sourceHospitalRecordId      String?
  selectedContactRecordIds    Json
  linkedInspectionRecordIds   Json
  linkedServiceOrderRecordIds Json
  performerRecordIds          Json
  sourceSnapshot              Json
  firstSeenAt                 DateTime @default(now())
  lastSeenAt                  DateTime @default(now())
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([emmaMailTemplate])
  @@index([lastSeenAt])
  @@index([sourceHospitalRecordId])
  @@index([sourceHospitalRecordId, updatedAt])
  @@index([linkedInspectionRecordIds], type: Gin)
}

model TrackedHospital {
  id                String   @id @default(cuid())
  airtableRecordId  String   @unique
  shortName         String?
  name              String?
  address           String?
  sourceSnapshot    Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastSeenAt        DateTime @default(now())
}

model CommunicationCursor {
  id               String                        @id @default(cuid())
  sourceEntityType CommunicationSourceEntityType
  sourceRecordId   String
  lastSignature    String
  revision         Int                           @default(0)
  firstObservedAt  DateTime                      @default(now())
  lastObservedAt   DateTime                      @default(now())
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@unique([sourceEntityType, sourceRecordId])
  @@index([lastObservedAt])
}

model CommunicationEvent {
  id               String                        @id @default(cuid())
  sourceEntityType CommunicationSourceEntityType
  sourceRecordId   String
  scenario         CommunicationScenario
  fingerprint      String                        @unique
  eventSnapshot    Json
  detectedAt       DateTime
  createdAt        DateTime                      @default(now())
  processedAt      DateTime?
  recipientsResolvedAt DateTime?
  recipientResolutionAttemptCount Int @default(0)
  nextRecipientResolutionAt DateTime?
  recipients       CommunicationEventRecipient[]
  deliveries       CommunicationDelivery[]

  @@index([sourceEntityType, sourceRecordId, detectedAt])
  @@index([scenario, processedAt, detectedAt])
  @@index([processedAt, recipientsResolvedAt, nextRecipientResolutionAt])
}

model CommunicationEventRecipient {
  id                    String                                  @id @default(cuid())
  communicationEventId  String
  recipientType         CommunicationRecipientType
  sourceContactRecordId String?
  email                 String?
  normalizedEmail       String?
  recipientKey          String
  resolutionStatus      CommunicationRecipientResolutionStatus
  resolutionReason      String?
  createdAt             DateTime                                @default(now())
  communicationEvent    CommunicationEvent                      @relation(fields: [communicationEventId], references: [id], onDelete: Cascade)
  delivery              CommunicationDelivery?

  @@unique([communicationEventId, normalizedEmail])
  @@unique([communicationEventId, recipientKey])
  @@index([communicationEventId, resolutionStatus])
}

model CommunicationDelivery {
  id                            String                              @id @default(cuid())
  communicationEventId          String
  communicationEventRecipientId String                              @unique
  scenario                      CommunicationScenario
  status                        CommunicationDeliveryStatus
  scheduledFor                  DateTime
  readyAt                       DateTime?
  deliveryKey                   String                              @unique
  scheduleReason                CommunicationDeliveryScheduleReason
  cancelReason                  CommunicationDeliveryCancelReason?
  attemptCount                  Int                                 @default(0)
  nextRetryAt                   DateTime?
  createdAt                     DateTime                            @default(now())
  updatedAt                     DateTime                            @updatedAt
  sentAt                        DateTime?
  failedAt                      DateTime?
  resendMessageId               String?
  sendingStartedAt              DateTime?
  preparedAt                    DateTime?
  sendSnapshot                  Json?
  emailMode                     String?
  actualRecipientEmail          String?
  lastError                     String?
  communicationEvent            CommunicationEvent                  @relation(fields: [communicationEventId], references: [id], onDelete: Cascade)
  communicationEventRecipient   CommunicationEventRecipient         @relation(fields: [communicationEventRecipientId], references: [id], onDelete: Cascade)
  portalAccessGrant             PortalAccessGrant?
  unsubscribeGrant             CommunicationUnsubscribeGrant?

  @@unique([communicationEventId, communicationEventRecipientId])
  @@index([status, scheduledFor])
  @@index([scenario, status, scheduledFor])
}

model CommunicationUnsubscribeGrant {
  id                      String                @id @default(cuid())
  publicId                String                @unique
  communicationDeliveryId String                @unique
  sourceHospitalRecordId  String
  normalizedEmail         String?
  canOptOut               Boolean
  expiresAt               DateTime
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  communicationDelivery   CommunicationDelivery @relation(fields: [communicationDeliveryId], references: [id], onDelete: Cascade)

  @@index([sourceHospitalRecordId, normalizedEmail])
  @@index([expiresAt])
}

model CommunicationOptOut {
  id                      String   @id @default(cuid())
  sourceHospitalRecordId  String
  normalizedEmail         String
  createdAt               DateTime @default(now())

  @@unique([sourceHospitalRecordId, normalizedEmail])
  @@index([normalizedEmail])
}

model PortalAccessGrant {
  id                      String                @id @default(cuid())
  publicId                String                @unique
  communicationDeliveryId String                @unique
  sourceHospitalRecordId  String
  entryContext            Json
  expiresAt               DateTime
  revokedAt               DateTime?
  lastOpenedAt            DateTime?
  openCount               Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  communicationDelivery   CommunicationDelivery @relation(fields: [communicationDeliveryId], references: [id], onDelete: Cascade)

  @@index([sourceHospitalRecordId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model CaseRecipient {
  id                       String      @id @default(cuid())
  trackedCaseId            String
  airtableContactRecordId  String
  name                     String?
  email                    String?
  normalizedEmail          String?
  eligible                 Boolean
  eligibilityReason        String?
  resolutionSource         String      @default("CONTACT_LINK")
  firstSeenAt              DateTime    @default(now())
  lastSeenAt               DateTime    @default(now())
  trackedCase              TrackedCase @relation(fields: [trackedCaseId], references: [id], onDelete: Cascade)

  @@unique([trackedCaseId, airtableContactRecordId])
  @@index([normalizedEmail, eligible])
}

model CaseEvent {
  id                    String      @id @default(cuid())
  trackedCaseId         String
  eventType             EventType
  fieldName             String?
  oldValue              Json?
  newValue              Json?
  triggersNotification  Boolean     @default(false)
  visibleToCustomer     Boolean     @default(true)
  eventFingerprint      String      @unique
  sourceModifiedAt      DateTime?
  detectedAt            DateTime    @default(now())
  trackedCase            TrackedCase @relation(fields: [trackedCaseId], references: [id], onDelete: Cascade)

  @@index([trackedCaseId, detectedAt])
  @@index([triggersNotification, detectedAt])
}

model NotificationBuffer {
  id                  String       @id @default(cuid())
  recipientName       String?
  recipientEmail      String
  normalizedEmail     String
  status              BufferStatus @default(OPEN)
  firstTriggerAt      DateTime
  lastTriggerAt       DateTime
  sendAfter           DateTime
  activeRecipientKey  String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  items               BufferItem[]

  @@index([status, sendAfter])
  @@index([normalizedEmail, createdAt])
}

model BufferItem {
  id             String             @id @default(cuid())
  bufferId       String
  trackedCaseId  String
  firstEventAt   DateTime
  lastEventAt    DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  buffer         NotificationBuffer @relation(fields: [bufferId], references: [id], onDelete: Cascade)
  trackedCase    TrackedCase        @relation(fields: [trackedCaseId], references: [id], onDelete: Cascade)

  @@unique([bufferId, trackedCaseId])
  @@index([trackedCaseId])
}

model Digest {
  id                       String       @id @default(cuid())
  type                     DigestType
  status                   DigestStatus @default(CREATED)
  sourceBufferId           String?      @unique
  intendedRecipientName    String?
  intendedRecipientEmail   String
  normalizedRecipientEmail String
  emailMode                String
  itemsCount               Int
  subject                  String
  actualRecipientEmail     String?
  sendAttempts             Int          @default(0)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  sendingStartedAt         DateTime?
  sentAt                   DateTime?
  failedAt                 DateTime?
  lastError                String?
  resendEmailId            String?
  nextRetryAt              DateTime?
  items                    DigestItem[]
  accessLink               AccessLink?

  @@index([status, createdAt])
  @@index([type, status, nextRetryAt, createdAt])
}

model AccessLink {
  id           String    @id @default(cuid())
  publicId     String    @unique
  digestId     String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastOpenedAt DateTime?
  openCount    Int       @default(0)
  digest       Digest    @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([revokedAt])
}

model DigestItem {
  id             String      @id @default(cuid())
  digestId       String
  trackedCaseId  String
  snapshot       Json
  changes        Json
  firstEventAt   DateTime?
  lastEventAt    DateTime?
  createdAt      DateTime    @default(now())
  digest         Digest      @relation(fields: [digestId], references: [id], onDelete: Cascade)
  trackedCase    TrackedCase @relation(fields: [trackedCaseId], references: [id], onDelete: Restrict)

  @@unique([digestId, trackedCaseId])
  @@index([trackedCaseId])
}

model SyncState {
  id                  String         @id @default(cuid())
  source              String         @default("AIRTABLE")
  entityType          SyncEntityType
  status              SyncStatus
  lastAttemptAt       DateTime?
  lastSuccessfulSyncAt DateTime?
  baselineCompletedAt DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([source, entityType])
  @@index([status, lastAttemptAt])
}

model WorkerState {
  id               String   @id
  version          String?
  startedAt        DateTime
  lastHeartbeatAt  DateTime
  lastSyncAt       DateTime?
  updatedAt        DateTime @updatedAt
}
